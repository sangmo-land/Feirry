# Modèle de .env pour la PRODUCTION (feirry.org). Copier en .env sur le serveur
# puis remplir les valeurs marquées <…>. Ne jamais versionner le vrai .env.

APP_NAME="FEIRRY"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show (une seule fois, à conserver)
APP_DEBUG=false
APP_URL=https://feirry.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<hôte>
DB_PORT=3306
DB_DATABASE=<base>
DB_USERNAME=<utilisateur dédié, pas root>
DB_PASSWORD=<mot de passe fort>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sécurité réseau
FORCE_HTTPS=true
# Seulement si le site est derrière Cloudflare ou un répartiteur de charge :
# adresses IP du proxy séparées par des virgules. Vide = aucun proxy.
TRUSTED_PROXIES=

# Double authentification admin : passer à true quand chaque membre l'a activée.
ADMIN_MFA_REQUIRED=false

MAIL_MAILER=smtp
MAIL_HOST=<serveur SMTP>
MAIL_PORT=587
MAIL_USERNAME=<compte>
MAIL_PASSWORD=<mot de passe>
MAIL_FROM_ADDRESS="contact@feirry.org"
MAIL_FROM_NAME="${APP_NAME}"
LEADS_NOTIFY_EMAIL=<adresse qui reçoit les alertes de demandes>
